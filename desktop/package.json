{
  "name": "acture-desktop",
  "productName": "Acture",
  "version": "1.0.0",
  "description": "Acture for Mac: the to-do list you talk to, in its own window.",
  "private": true,
  "main": "main.js",
  "author": "Acture",
  "scripts": {
    "start": "electron .",
    "dev": "ACTURE_URL=http://localhost:3000 electron .",
    "dist": "electron-builder --mac dmg --arm64 --x64"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "co.acture.desktop",
    "productName": "Acture",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "package.json"],
    "protocols": [{ "name": "Acture", "schemes": ["acture"] }],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "darkModeSupport": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Acture listens when you press the mic, to turn what you say into to-dos."
      }
    },
    "dmg": {
      "title": "Acture",
      "artifactName": "Acture-${version}-${arch}.dmg"
    }
  }
}
